// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  name              String?
  role              Role?     @default(USER)
  subscriptionUntil DateTime?
  links             Link[] // Relasi One-to-Many ke Link
  domains           Domain[] // Relasi One-to-Many ke Domain
  createdAt         DateTime  @default(now())
}

model Link {
  id              Int       @id @default(autoincrement())
  originalUrl     String
  shortSlug       String    @unique
  isCustom        Boolean   @default(false)
  userId          Int?
  user            User?     @relation(fields: [userId], references: [id])
  guestIdentifier String?
  ipAddress       String?
  domainId        Int?
  domain          Domain?   @relation(fields: [domainId], references: [id])
  expiresAt       DateTime?
  mode            MODE?     @default(PERSONAL)
  clicks          Click[] // Relasi One-to-Many ke Click
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Domain {
  id     Int    @id @default(autoincrement())
  userId Int
  host   String? @unique

  verificationToken String?  @unique
  isVerified        Boolean? @default(false)

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  links Link[]
}

model Click {
  id        Int      @id @default(autoincrement())
  linkId    Int
  link      Link     @relation(fields: [linkId], references: [id])
  ipAddress String?
  userAgent String?
  referer   String?
  clickedAt DateTime @default(now())

  @@index([linkId, clickedAt])

}

model UniqueVisitor {
  id          Int      @id @default(autoincrement())

  linkId      Int

  fingerprint String
  visitedDate String

  createdAt   DateTime @default(now())

  @@unique([fingerprint, visitedDate])
}

model LinkPreview {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  title       String?
  description String?
  image       String?
  siteName    String?
  createdAt   DateTime @default(now())
}

enum Role {
  USER
  SUPER_USER
  ADMIN
}

enum MODE {
  PERSONAL
  DPD
  MPM
}
