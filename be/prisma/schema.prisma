// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  name              String?
  role              Role?     @default(USER)
  subscriptionUntil DateTime?
  links             Link[] // Relasi One-to-Many ke Link
  domains           Domain[] // Relasi One-to-Many ke Domain
  bioPages          BioPage[] // Relasi One-to-Many ke BioPage
  createdAt         DateTime  @default(now())
}

model Link {
  id              Int       @id @default(autoincrement())
  originalUrl     String
  shortSlug       String    @unique
  isCustom        Boolean   @default(false)
  userId          Int?
  user            User?     @relation(fields: [userId], references: [id])
  guestIdentifier String?
  ipAddress       String?
  domainId        Int?
  domain          Domain?   @relation(fields: [domainId], references: [id])
  expiresAt       DateTime?
  mode            MODE?     @default(PERSONAL)
  password        String?
  isProtected     Boolean   @default(false)
  clicks          Click[] // Relasi One-to-Many ke Click
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Domain {
  id     Int    @id @default(autoincrement())
  userId Int
  host   String? @unique

  verificationToken String?  @unique
  isVerified        Boolean? @default(false)

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  links Link[]
}

model Click {
  id        Int      @id @default(autoincrement())
  linkId    Int
  link      Link     @relation(fields: [linkId], references: [id])
  ipAddress String?
  userAgent String?
  referer   String?
  clickedAt DateTime @default(now())

  device    String?  
  browser   String? 
  os        String?  
  country   String? 

  @@index([linkId, clickedAt])

}

model UniqueVisitor {
  id          Int      @id @default(autoincrement())

  linkId      Int

  fingerprint String
  visitedDate String

  createdAt   DateTime @default(now())

  @@unique([fingerprint, visitedDate])
}

model LinkPreview {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  title       String?
  description String?
  image       String?
  siteName    String?
  createdAt   DateTime @default(now())
}

model BioPage {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  title     String
  bio       String?
  avatar    String?
  theme     String   @default("dark")   // dark | light | midnight | aurora | sunset
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     BioLink[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BioLink {
  id        Int      @id @default(autoincrement())
  bioPageId Int
  bioPage   BioPage  @relation(fields: [bioPageId], references: [id], onDelete: Cascade)
  label     String
  url       String
  icon      String?  // github | instagram | youtube | twitter | globe | dll
  type      String   @default("LINK")  // LINK | PINNED | SOCIAL
  order     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  SUPER_USER
  ADMIN
}

enum MODE {
  PERSONAL
  DPD
  MPM
}
